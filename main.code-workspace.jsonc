{
    "folders": [
        {
            "name": "Main",
            "path": "."
        }/**///
        ,{
            "name": "Msys2",
            "path": "C:\\msys64"
        }/**///
        ,{
            "name": "Zenhance",
            "path": "..\\..\\..\\Documents\\ZShell\\Scripts\\Zenhance"
            //"path": "../../../.config/zsh/zenhance"
        }/**///
        ,{
            "name": "PSenhance",
            "path": "..\\..\\..\\Documents\\PowerShell\\Scripts\\PSenhance"
            //"path": "../../../.config/pwsh/psenhance"
        }/**///
        ,{
            "name": "LLEdge",
            "path": "..\\LLEdge"            
            //"path": "../lledge"
        }//*/
    ],
    "settings": {
        "vsicons.associations.files": [
            {
                "icon": "clangd",
                "extensions": [
                    ".clangd",
                    ".clangd.template",
                    ".clang-format",
                    ".clang-format-ignore",
                    ".clang-tidy",
                    ".clang-tidy-ignore",
                    ".clang-tidy-apply-replacements"
                ],
                "format": "svg"
            },
            {
                "icon": "vscode",
                "extensions": ["settings.json", "tasks.json", "launch.json"],
                "format": "svg"
            },
            {
                "icon": "json",
                "extensions": [".json"],
                "format": "svg"
            }
        ],
        "vsicons.presets.hideExplorerArrows": true,
        "files.associations": {
            ".clang-format": "yaml",
            ".clang-tidy": "yaml",
            ".clangd": "yaml",
            "*.inc": "cpp",
            "*.inl": "cpp"
        },
        "hediet.vscode-drawio.appearance": "automatic",
        "clangd.enable": true,
        /** /// Windows Paths
        "clangd.path": "C:\\Tools\\LLVM\\bin\\clangd.exe",
        "cmake.cmakePath": "C:\\Tools\\CMake\\bin\\cmake.exe",
        "git.path": "C:\\Tools\\Git\\bin\\git.exe",
        /**/// Msys2 Paths
        "clangd.path": "C:\\msys64\\clang64\\bin\\clangd.exe",
        "cmake.cmakePath": "C:\\msys64\\usr\\bin\\cmake.exe",
        "git.path": "C:\\msys64\\usr\\bin\\git.exe",
        /** /// Linux Paths
        "clangd.path": "/usr/bin/clangd",
        "cmake.cmakePath": "/usr/bin/cmake",
        "git.path": "/usr/bin/git",
        //*/
        "editor.semanticHighlighting.enabled": true,
        "editor.semanticTokenColorCustomizations": {
            "rules": {
                "class": "#ffef63",
                "enum": "#5fb2fa",
                "function": "#df9fff",
                "enumMember": "#b4b4b4",
                "namespace": "#ffa846",
                "struct": "#ffef63",
                "variable": "#fefefe",
                "property": "#b4b4b4",
                "parameter": "#60ffc5",
                "macro": "#df9fff",
                "method": "#df9fff"
            }
        },
        "terminal.integrated.defaultProfile.windows": "PowerShell",
        "terminal.integrated.profiles.windows": {
            "PowerShell": {
                "path": "C:\\Program Files\\WindowsApps\\Microsoft.PowerShell_7.6.3.0_x64__8wekyb3d8bbwe\\pwsh.exe",
                "icon": "terminal-powershell"
            },
            "Command Prompt": {
                "path": [
                    "${env:windir}\\Sysnative\\cmd.exe",
                    "${env:windir}\\System32\\cmd.exe"
                ],
                "args": [],
                "icon": "terminal-cmd"
            },
            "Clang64 (MSYS)": {
                "overrideName": true,
                "path": "msys",
                "args": ["-e", "clang64", "-s", "zsh"],
                "icon": "terminal-git-bash"
            },
            "ClangArm64 (MSYS)": {
                "overrideName": true,
                "path": "msys",
                "args": ["-e", "clangarm64", "-s", "zsh"],
                "icon": "terminal-git-bash"
            },
            "MinGW64 (MSYS)": {
                "overrideName": true,
                "path": "msys",
                "args": ["-e", "mingw64", "-s", "zsh"],
                "icon": "terminal-git-bash"
            },
            "MinGW32 (MSYS)": {
                "overrideName": true,
                "path": "msys",
                "args": ["-e", "mingw32", "-s", "zsh"],
                "icon": "terminal-git-bash"
            },
            "UCRT64 (MSYS)": {
                "overrideName": true,
                "path": "msys",
                "args": ["-e", "ucrt64", "-s", "zsh"],
                "icon": "terminal-git-bash"
            },
            "Msys2 Shell": {
                "overrideName": true,
                "path": "msys",
                "args": ["-s", "zsh"],
                "icon": "terminal-git-bash"
            }
        },
        "powershell.cwd": "Main"
    }
}